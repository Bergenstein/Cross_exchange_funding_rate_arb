# Environment variables for live trading
# Copy this to .env and fill in your API keys

# Trading Mode
MODE=paper  # paper or live

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# Bybit API
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# Gate.io API
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here

# OKX API (optional)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSWORD=your_okx_password_here

# Risk Management
MAX_POSITION_SIZE=1000  # USD per position
MAX_POSITIONS=5  # Maximum concurrent positions
MIN_SPREAD_APY=30  # Minimum spread to enter trade
EXIT_SPREAD_APY=10  # Exit if spread drops below this

# Telegram Alerts (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Monitoring
LOG_LEVEL=INFO
ALERT_EMAIL=your_email@example.com
